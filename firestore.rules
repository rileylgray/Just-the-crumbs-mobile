rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- Users --------------------------------------------------------------
    // Profiles are publicly readable (author names on the public feed); each
    // user may only write their own.
    match /users/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ---- Recipes ------------------------------------------------------------
    match /recipes/{recipeId} {
      // A non-owner "like" may only change likeCount, by exactly ±1, and only on
      // a public recipe. Everything else on the doc is owner-only.
      function isLikeCountChange() {
        return resource.data.public == true
               && request.resource.data.diff(resource.data)
                    .affectedKeys().hasOnly(['likeCount'])
               && request.resource.data.likeCount is int
               && (request.resource.data.likeCount
                     == resource.data.get('likeCount', 0) + 1
                   || request.resource.data.likeCount
                     == resource.data.get('likeCount', 0) - 1);
      }

      allow read: if resource.data.public == true
                  || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
                    && (resource.data.userId == request.auth.uid
                        || isLikeCountChange());
      allow delete: if signedIn()
                    && resource.data.userId == request.auth.uid;

      // ---- Likes (subcollection) --------------------------------------------
      // One doc per user who liked the recipe, keyed by their uid. Anyone signed
      // in (incl. guests) may like a public recipe; you may only add/remove your
      // own like.
      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create, delete: if signedIn()
                      && likeUid == request.auth.uid
                      && get(/databases/$(database)/documents/recipes/$(recipeId))
                          .data.public == true;
      }

      // ---- Comments (subcollection) -----------------------------------------
      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/recipes/$(recipeId))
                        .data.public == true;

        allow create: if signedIn()
                      && request.resource.data.userId == request.auth.uid
                      && get(/databases/$(database)/documents/recipes/$(recipeId))
                          .data.public == true
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0
                      && request.resource.data.content.size() < 2000;

        allow delete: if signedIn()
                      && resource.data.userId == request.auth.uid;
      }
    }

    // ---- Shares -------------------------------------------------------------
    // A self-contained recipe snapshot keyed by an unguessable code. Knowing the
    // code is the authorization to read it, so any signed-in user may read;
    // only the owner may create/update/delete their snapshot.
    match /shares/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- Reports ------------------------------------------------------------
    // Any signed-in user (incl. guests) may file a report against a public
    // recipe. Reports are review-only: they can't be read or changed from the
    // client — triage happens via the Firebase console / Admin SDK, which
    // bypass these rules.
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.recipeId is string
                    && request.resource.data.reason is string;
    }

    // ---- Categories ---------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
                    && resource.data.userId == request.auth.uid;
    }
  }
}
